### Variables
@baseUrl = http://localhost:3000

### =================================================================
### КРИТЕРІЙ 2 — GET /announcements (4 бали)
### =================================================================

### -----------------------------------------------------------------
### 2.1. GET /announcements — список без параметрів
###      → 200, {data, pagination{total,page,totalPages,perPage}}
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements

### -----------------------------------------------------------------
### 2.2. GET /announcements — пошук "asus" (lowercase)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?search=asus

### -----------------------------------------------------------------
### 2.3. GET /announcements — пошук "ASUS" (UPPERCASE)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?search=ASUS

### -----------------------------------------------------------------
### 2.4. GET /announcements — пошук "Asus" (Mixed)
###      Усі три варіанти повертають однаковий результат
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?search=Asus

### -----------------------------------------------------------------
### 2.5. GET /announcements — пошук, що нічого не знаходить
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?search=qweasdzxc

### -----------------------------------------------------------------
### 2.6. GET /announcements — сортування за датою (newest, default)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?sort=newest

### -----------------------------------------------------------------
### 2.7. GET /announcements — сортування за датою (oldest)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?sort=oldest

### -----------------------------------------------------------------
### 2.8. GET /announcements — пагінація, сторінка 1 (10 записів)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?page=1

### -----------------------------------------------------------------
### 2.9. GET /announcements — пагінація, сторінка 2 (10 записів)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?page=2

### -----------------------------------------------------------------
### 2.10. GET /announcements — пагінація, сторінка 3 (5 записів)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?page=3

### -----------------------------------------------------------------
### 2.11. GET /announcements — комбінація: search + sort + page
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?search=asus&sort=oldest&page=1

### -----------------------------------------------------------------
### 2.12. GET /announcements — невалідний sort → 400
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?sort=invalid_value

### -----------------------------------------------------------------
### 2.13. GET /announcements — невалідний page (≤ 0) → 400
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?page=0


### =================================================================
### КРИТЕРІЙ 3 — GET /announcements/:id (1 бал)
### =================================================================

### -----------------------------------------------------------------
### 3.1. GET /announcements/:id — існуючий ID → 200 + повний об'єкт
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements/1

### -----------------------------------------------------------------
### 3.2. GET /announcements/:id — неіснуючий ID → 404
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements/99999

### -----------------------------------------------------------------
### 3.3. GET /announcements/:id — нечислове id → 400 (валідація params)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements/abc


### =================================================================
### КРИТЕРІЙ 4 — POST /announcements (3 бали)
### =================================================================

### -----------------------------------------------------------------
### 4.1. POST — валідні дані → 201 + створений об'єкт
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "Продам ноутбук ASUS",
  "description": "Відмінний стан, 16GB RAM, SSD 512GB",
  "price": 18000,
  "category": "sale",
  "contactInfo": "0991234567"
}

### -----------------------------------------------------------------
### 4.2. POST — інша валідна категорія (service)
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "Ремонт холодильників на дому",
  "description": "Виїзд по місту, гарантія 6 місяців",
  "price": 500,
  "category": "service",
  "contactInfo": "0671234567"
}

### -----------------------------------------------------------------
### 4.3. POST — невалідні дані (усі поля одночасно неправильні) → 400
###      title < 5, description < 10, price ≤ 0, category поза списком,
###      contactInfo < 5
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "abc",
  "description": "short",
  "price": -5,
  "category": "invalid",
  "contactInfo": "x"
}

### -----------------------------------------------------------------
### 4.4. POST — title задовгий (> 100 символів) → 400
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "description": "Valid description ten chars",
  "price": 100,
  "category": "sale",
  "contactInfo": "phone1"
}

### -----------------------------------------------------------------
### 4.5. POST — price = 0 (має бути > 0) → 400
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "Valid title",
  "description": "Valid description",
  "price": 0,
  "category": "sale",
  "contactInfo": "phone1"
}

### -----------------------------------------------------------------
### 4.6. POST — невідома категорія → 400
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "Valid title",
  "description": "Valid description",
  "price": 100,
  "category": "unknown_category",
  "contactInfo": "phone1"
}

### -----------------------------------------------------------------
### 4.7. POST — пропущене обов'язкове поле (description) → 400
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "Valid title here",
  "price": 100,
  "category": "sale",
  "contactInfo": "phone1"
}


### =================================================================
### КРИТЕРІЙ 5 — PATCH /announcements/:id (3 бали)
### =================================================================

### -----------------------------------------------------------------
### 5.1. PATCH — оновлення одного поля (price)
###      title/description/category НЕ повинні змінитися; updatedAt — так
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{
  "price": 17500
}

### -----------------------------------------------------------------
### 5.2. PATCH — оновлення кількох полів одночасно
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{
  "price": 17000,
  "description": "Знижка! Відмінний стан, 16GB RAM, SSD 512GB",
  "category": "sale"
}

### -----------------------------------------------------------------
### 5.3. PATCH — порожнє тіло → 400 (потрібне хоча б одне поле)
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{}

### -----------------------------------------------------------------
### 5.4. PATCH — невалідне значення title (< 5) → 400
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{
  "title": "ab"
}

### -----------------------------------------------------------------
### 5.5. PATCH — невалідне значення price (≤ 0) → 400
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{
  "price": -5
}

### -----------------------------------------------------------------
### 5.6. PATCH — неіснуючий ID → 404
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/99999
Content-Type: application/json

{
  "title": "Новий заголовок для оголошення"
}


### =================================================================
### КРИТЕРІЙ 6 — DELETE /announcements/:id (1 бал)
### =================================================================

### -----------------------------------------------------------------
### 6.1. DELETE — видалення існуючого → 204 без тіла
### -----------------------------------------------------------------
DELETE {{baseUrl}}/announcements/1

### -----------------------------------------------------------------
### 6.2. DELETE — повторне видалення тієї ж ID → 404
###      (виконується після 6.1 — запис уже видалено)
### -----------------------------------------------------------------
DELETE {{baseUrl}}/announcements/1

### -----------------------------------------------------------------
### 6.3. DELETE — неіснуючий ID → 404
### -----------------------------------------------------------------
DELETE {{baseUrl}}/announcements/99999
