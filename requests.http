### Variables
@baseUrl = http://localhost:3000

### -----------------------------------------------------------------
### 1. GET /announcements — список без параметрів
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements

### -----------------------------------------------------------------
### 2. GET /announcements — пошук по назві (case-insensitive ASCII)
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?search=ASUS

### -----------------------------------------------------------------
### 3. GET /announcements — сортування + пагінація
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements?sort=oldest&page=2

### -----------------------------------------------------------------
### 4. GET /announcements/:id — існуючий ID
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements/1

### -----------------------------------------------------------------
### 5. GET /announcements/:id — неіснуючий ID → 404
### -----------------------------------------------------------------
GET {{baseUrl}}/announcements/99999

### -----------------------------------------------------------------
### 6. POST /announcements — валідні дані → 201
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "Продам ноутбук ASUS",
  "description": "Відмінний стан, 16GB RAM, SSD 512GB",
  "price": 18000,
  "category": "sale",
  "contactInfo": "0991234567"
}

### -----------------------------------------------------------------
### 7. POST /announcements — невалідні дані → 400
###    title коротший за 5, price ≤ 0, category поза списком,
###    description коротший за 10, contactInfo коротший за 5
### -----------------------------------------------------------------
POST {{baseUrl}}/announcements
Content-Type: application/json

{
  "title": "abc",
  "description": "short",
  "price": -5,
  "category": "invalid",
  "contactInfo": "x"
}

### -----------------------------------------------------------------
### 8. PATCH /announcements/:id — часткове оновлення
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{
  "price": 17500,
  "description": "Знижка! Відмінний стан, 16GB RAM, SSD 512GB"
}

### -----------------------------------------------------------------
### 9. PATCH /announcements/:id — порожнє тіло → 400
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/1
Content-Type: application/json

{}

### -----------------------------------------------------------------
### 10. PATCH /announcements/:id — неіснуючий ID → 404
### -----------------------------------------------------------------
PATCH {{baseUrl}}/announcements/99999
Content-Type: application/json

{
  "title": "Новий заголовок для оголошення"
}

### -----------------------------------------------------------------
### 11. DELETE /announcements/:id — видалення → 204
### -----------------------------------------------------------------
DELETE {{baseUrl}}/announcements/1

### -----------------------------------------------------------------
### 12. DELETE /announcements/:id — неіснуючий ID → 404
### -----------------------------------------------------------------
DELETE {{baseUrl}}/announcements/99999
